
# --- 1. CONFIGURACIÓN DEL SERVIDOR ---
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# --- 2. BASE DE DATOS (MySQL 8.4) ---
DB_URL=jdbc:mysql://localhost:3309/almacen_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Lima
DB_USERNAME=almacen_user
DB_PASSWORD=tu_password_seguro_aqui

# --- 3. HIBERNATE / JPA ---
JPA_DDL_AUTO=validate
SHOW_SQL=false
FORMAT_SQL=false

# --- 4. MIGRACIONES FLYWAY ---
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# --- 5. SEGURIDAD Y JWT (HMAC-SHA256 - Mínimo 256 bits codificado en Base64) ---
JWT_SECRET=reemplazar_con_clave_base64_segura_de_al_menos_32_bytes
JWT_EXPIRATION_MS=86400000

# --- 6. SEGURIDAD CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- 7. DOCUMENTACIÓN OPENAPI / SWAGGER UI ---
OPENAPI_ENABLED=true

# --- 8. LOGGING ---
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=WARN
